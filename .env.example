# ---- LLM (used only to parse free-text deal emails; the deterministic parser runs first) ----
# gemini | anthropic | mock
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Gmail (IMAP with an App Password; requires 2-Step Verification on the account) ----
# Only senders from these domains can trigger the workflow (comma separated). Blank = any.
ALLOWED_SENDER_DOMAINS=novacrm.example
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=
# Emails whose subject contains this are treated as deal notifications.
DEAL_SUBJECT_PATTERN=Closed Won
POLL_SECONDS=30

# ---- Voice AI (Bland is the default: one POST, returns a single disposition tag) ----
# bland | vapi | mock
VOICE_PROVIDER=bland
BLAND_API_KEY=
# Optional caller id for Bland.
BLAND_FROM_NUMBER=
# hangup | ignore. Use ignore if your handset screens unknown callers: the screening prompt
# reads as a voicemail greeting and the call is dropped before the AE ever speaks.
BLAND_VOICEMAIL_ACTION=hangup
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
# JSON map of AE name -> E.164 phone number.
AE_PHONE_DIRECTORY={"Alex Rivera": "+15550100001"}
# Seconds to wait between voice attempts (0 in tests).
VOICE_RETRY_DELAY_SECONDS=20
VOICE_MAX_ATTEMPTS=2

# ---- Rocketlane ----
ROCKETLANE_API_KEY=
# Project owner per tier. Enterprise = the dedicated CSM, Growth = whoever owns the pooled queue.
# Blank = ROCKETLANE_OWNER_EMAIL for both.
ROCKETLANE_ENTERPRISE_CSM_EMAIL=
ROCKETLANE_GROWTH_CSM_EMAIL=
ROCKETLANE_OWNER_EMAIL=you@yourcompany.com
# Optional. If set, projects are created from these Rocketlane templates.
# If blank, the agent builds the 4-phase / 15-task plan itself from templates.py.
ROCKETLANE_TEMPLATE_ID_ENTERPRISE=
ROCKETLANE_TEMPLATE_ID_GROWTH=
ROCKETLANE_MAX_RETRIES=3

# ---- Slack (leave SLACK_BOT_TOKEN blank to use the mock) ----
SLACK_BOT_TOKEN=
SLACK_ESCALATION_CHANNEL=#onboarding-escalations

# ---- Escalation ----
HUMAN_ESCALATION_EMAIL=cs-leads@novacrm.example
